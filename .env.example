# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

PORT=3000
NODE_ENV=development

# Any long random text (at least 16 characters).
# Example: run node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=acquirejobs
