<%
  // Usage: include('../partials/pagination', { pagination, baseUrl: '/jobs', query: { keyword, city } })
  const linkTo = (pageNumber) => {
    const params = new URLSearchParams();
    Object.entries(query || {}).forEach(([key, value]) => { if (value) params.set(key, value); });
    params.set('page', pageNumber);
    return baseUrl + '?' + params.toString();
  };
%>
<% if (pagination.totalPages > 1) { %>
  <nav class="pagination" aria-label="Pagination">
    <% if (pagination.hasPrev) { %><a class="btn btn--outline btn--sm" href="<%= linkTo(pagination.page - 1) %>">Previous</a><% } else { %><span class="btn btn--outline btn--sm is-disabled" aria-disabled="true">Previous</span><% } %>
    <span class="pagination__status">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
    <% if (pagination.hasNext) { %><a class="btn btn--outline btn--sm" href="<%= linkTo(pagination.page + 1) %>">Next</a><% } else { %><span class="btn btn--outline btn--sm is-disabled" aria-disabled="true">Next</span><% } %>
  </nav>
<% } %>
