<div class="toast-region" id="toast-region" aria-live="polite"></div>

<dialog class="modal" id="confirm-dialog" aria-labelledby="confirm-title">
  <form method="dialog" class="modal__box">
    <div class="modal__icon-wrap" aria-hidden="true">
      <%- icon('alert') %>
    </div>
    <div class="modal__content">
      <h2 class="modal__title" id="confirm-title">Are you sure?</h2>
      <p class="modal__text" id="confirm-text"></p>
    </div>
    <div class="modal__actions">
      <button class="btn btn--outline" value="cancel">Cancel</button>
      <button class="btn btn--primary" value="ok" id="confirm-ok">Confirm</button>
    </div>
  </form>
</dialog>

