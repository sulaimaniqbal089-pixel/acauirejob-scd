<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
  <title><%= locals.title ? title + ' | ' : '' %><%= siteName %></title>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <meta name="description" content="Find jobs across Pakistan, apply with one CV and track every application on AcquireJobs.pk.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/public.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="brand-strip" aria-hidden="true"></div>

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="<%= siteName %> home">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">AcquireJobs<span class="brand__tld">.pk</span></span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <%- icon('menu') %><span class="sr-only">Open menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <a class="site-nav__link <%= currentPath === '/jobs' ? 'is-active' : '' %>" href="/jobs">Browse jobs</a>
      <% if (!user) { %>
        <a class="site-nav__link" href="/register?role=employer">For employers</a>
        <div class="site-nav__actions">
          <a class="btn btn--ghost" href="/login">Log in</a>
          <a class="btn btn--primary" href="/register">Sign up</a>
        </div>
      <% } else { %>
        <a class="site-nav__link" href="/dashboard">Dashboard</a>
        <div class="user-menu" data-dropdown>
          <button class="user-menu__button" type="button" aria-haspopup="menu" aria-expanded="false" data-dropdown-toggle>
            <span class="avatar" aria-hidden="true"><%= fmt.initials(user.full_name) %></span>
            <span class="user-menu__name"><%= user.full_name %></span>
            <%- icon('chevron') %>
          </button>
          <div class="user-menu__panel" role="menu">
            <p class="user-menu__meta"><strong><%= c.ROLE_LABELS[user.role] %></strong><br><%= user.email %></p>
            <a role="menuitem" href="/account/settings">Account settings</a>
            <button role="menuitem" type="button" data-action data-api="/api/auth/logout" data-method="POST">Log out</button>
          </div>
        </div>
      <% } %>
    </nav>
  </div>
</header>

<main id="main">
