<%- include('../partials/header') %>
<section class="auth">
  <aside class="auth__aside">
    <div class="auth__aside-content">
      <div class="auth__aside-tag"><%- icon('shield') %> National Talent Platform</div>
      <h2 class="auth__aside-title">Welcome back.</h2>
      <p>Pick up where you left off: new vacancies, application updates and your applicants are waiting.</p>

      <div class="auth__aside-perks">
        <div class="perk-item">
          <%- icon('check') %>
          <span>Track applications from Pending to Hired</span>
        </div>
        <div class="perk-item">
          <%- icon('check') %>
          <span>Direct recruiter notifications without spam</span>
        </div>
        <div class="perk-item">
          <%- icon('check') %>
          <span>100% verified corporate employers</span>
        </div>
      </div>
    </div>
  </aside>

  <div class="auth__panel">
    <div class="auth__box">
      <div class="auth__box-header">
        <h1 class="auth__title">Log in</h1>
        <p class="auth__lead">New to AcquireJobs.pk? <a href="/register">Create an account</a></p>
      </div>

      <form data-api="/api/auth/login" data-method="POST" novalidate id="login-form">
        <input type="hidden" name="next" value="<%= next %>">
        <%- include('../partials/field', { field: { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email', placeholder: 'e.g. admin@acquirejobs.pk' } }) %>
        <%- include('../partials/field', { field: { name: 'password', label: 'Password', type: 'password', required: true, autocomplete: 'current-password', placeholder: 'Your password' } }) %>
        <p class="form-error" data-form-error role="alert"></p>
        <button class="btn btn--primary btn--block btn--lg" type="submit">
          <span>Log in</span>
          <%- icon('arrow-right') %>
        </button>
      </form>

      <details class="demo-box" open>
        <summary>Demo accounts</summary>
        <p class="demo-box__hint">Click any row to auto-fill the credentials:</p>
        <table class="demo-box__table">
          <tr class="demo-row" data-email="admin@acquirejobs.pk" data-pass="Admin@12345" title="Click to fill">
            <th>Admin</th>
            <td>admin@acquirejobs.pk</td>
            <td><code>Admin@12345</code></td>
          </tr>
          <tr class="demo-row" data-email="hr@techvista.pk" data-pass="Password@123" title="Click to fill">
            <th>Employer</th>
            <td>hr@techvista.pk</td>
            <td><code>Password@123</code></td>
          </tr>
          <tr class="demo-row" data-email="ayesha@example.pk" data-pass="Password@123" title="Click to fill">
            <th>Job seeker</th>
            <td>ayesha@example.pk</td>
            <td><code>Password@123</code></td>
          </tr>
        </table>
      </details>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.demo-row').forEach(row => {
    row.addEventListener('click', () => {
      const emailInput = document.querySelector('input[name="email"]');
      const passInput = document.querySelector('input[name="password"]');
      if (emailInput && passInput) {
        emailInput.value = row.dataset.email;
        passInput.value = row.dataset.pass;
        passInput.focus();
      }
    });
  });
</script>
<%- include('../partials/footer') %>
